                    { name: "로얄 세이버 (Royal Saber)", desc: "성창 그람으로 강력한 일격을 날려 적을 꿰뚫는다." },
                    { name: "파이널 엘리시온 (Final Elysion)", desc: "성순 이지스에서 모든 것을 정화하는 거대한 빛의 빔을 발사한다." }
                ],
                evoPrev: [], evoNext: []
            },
            {
                id: 21, no: "No.021", nameKo: "베르제브몬", nameEn: "BEELZEMON",
                stage: "궁극체", attribute: "바이러스", type: "마왕형", field: "나이트메어 솔저스",
                artKey: "beelzemon",
                desc: "수많은 악마형 디지몬을 통솔하는 7대 마왕 중 '폭식'을 관장하는 마왕형 디지몬. 고독을 사랑하며 절대 타인과 무리 짓지 않는 냉혹한 승부사지만, 약자를 괴롭히는 비열한 짓은 싫어하는 긍지를 지녔다.",
                stats: { hp: 93, atk: 98, def: 88, spd: 97, int: 91 },
                skills: [
                    { name: "더블 임팩트 (Double Impact)", desc: "애용하는 2정의 샷건 '베렌헤나'를 초고속으로 연사한다." },
                    { name: "다크니스 클로 (Darkness Claw)", desc: "예리한 손톱을 치켜들고 적을 단숨에 베어 가른다." }
                ],
                evoPrev: [], evoNext: []
            },
            {
                id: 22, no: "No.022", nameKo: "알파몬", nameEn: "ALPHAMON",
                stage: "궁극체", attribute: "백신", type: "성기사형", field: "바이러스 버스터즈",
                artKey: "alphamon",
                desc: "13체의 성기사 '로얄 나이츠' 중 한 명이지만, 평소에는 모습을 드러내지 않아 '고고한 은둔자'로 불리는 억지력적 존재. 전투 시 지나간 시간을 순식간에 되감아 공격을 반복하는 궁극의 힘 '알파 인포스'를 지녔다.",
                stats: { hp: 98, atk: 99, def: 98, spd: 99, int: 98 },
