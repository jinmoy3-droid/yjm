                    { name: "성검 그레이달파 (Seiken Gradalpha)", desc: "마법진의 중심에서 빛의 성검을 뽑아 적을 일격에 베어 넘긴다." }
                ],
                evoPrev: [], evoNext: []
            },
            {
                id: 23, no: "No.023", nameKo: "루체몬", nameEn: "LUCEMON",
                stage: "성장기", attribute: "백신", type: "천사형", field: "바이러스 버스터즈",
                artKey: "lucemon",
                desc: "아득한 고대 디지털 월드에 강림한 어린아이 모습의 천사형 디지몬. 12장의 날개를 지녔으며 성장기임에도 불구하고 일반 궁극체를 아득히 능가하는 압도적인 지혜와 마력을 보유하고 있다.",
                stats: { hp: 88, atk: 92, def: 86, spd: 90, int: 99 },
                skills: [
                    { name: "그랜드 크로스 (Grand Cross)", desc: "10개의 초고열 광구를 십자 형태로 배열해 발사하는 필살기." },
                    { name: "디바인 피트 (Divine Feat)", desc: "빛의 검을 생성하여 적을 관통한다." }
                ],
                evoPrev: [], evoNext: []
            },
            {
                id: 24, no: "No.024", nameKo: "디아블로몬", nameEn: "DIABOROMON",
                stage: "궁극체", attribute: "불명", type: "종족불명", field: "나이트메어 솔저스",
                artKey: "diaboromon",
                desc: "네트워크상의 온갖 데이터를 흡수하여 진화와 거대화를 반복한 정체불명의 궁극체. 네트워크 세계를 파괴하기 위해 행동하며 자기 복제를 통해 수만 체로 증식하는 공포의 존재다.",
                stats: { hp: 95, atk: 97, def: 90, spd: 98, int: 95 },
                skills: [
                    { name: "카타스트로피 캐논 (Catastrophe Cannon)", desc: "가슴의 포구에서 파괴 에너지를 응축해 발사한다." },
                    { name: "케이블 크러셔 (Cable Crusher)", desc: "신축자재로 늘어나는 팔을 뻗어 적을 짓눌러 버린다." }
                ],
                evoPrev: [], evoNext: []
            },
            {
                id: 25, no: "No.025", nameKo: "블랙워그레이몬", nameEn: "BLACKWARGREYMON",
                stage: "궁극체", attribute: "바이러스", type: "용인형", field: "메탈 엠파이어",
                artKey: "blackwargreymon",
                desc: "'칠흑의 용전사'라 불리며 두려움의 대상이 된 바이러스 속성의 워그레이몬. 정의를 위해서가 아닌 자신의 존재 의의를 찾기 위해 싸우며, 비겁한 수단을 혐오하는 무인 기질을 지녔다.",
                stats: { hp: 95, atk: 97, def: 92, spd: 90, int: 87 },
                skills: [
                    { name: "암흑의 테라 광선 (Black Gaia Force)", desc: "세계에 존재하는 모든 '부(負)의 염원'을 한 점에 모아 발사한다." },
                    { name: "블랙 토네이도 (Black Tornado)", desc: "칠흑의 회오리를 일으키며 적진으로 돌격한다." }
                ],
                evoPrev: [], evoNext: []
            }
        ];

        // =========================================================================
        // 3. STATE & LOCALSTORAGE INITIALIZATION
        // =========================================================================
        const FAV_STORAGE_KEY = 'digimon_encyclopedia_favorites_v1';
        let favorites = new Set(JSON.parse(localStorage.getItem(FAV_STORAGE_KEY) || '[]'));
        let currentAttrFilter = 'ALL';
        let currentStageFilter = 'ALL';
        let showFavoritesOnly = false;
        let currentModalDigimonId = null;

        document.addEventListener('DOMContentLoaded', () => {
            updateCounters();
            renderGrid();

            const searchInput = document.getElementById('searchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            searchInput.addEventListener('input', () => {
                clearBtn.classList.toggle('hidden', searchInput.value.trim() === '');
                renderGrid();
            });
        });

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2200);
        }

        function updateCounters() {
            document.getElementById('totalCountDisplay').innerHTML = `${digimonDatabase.length} <span class="text-xs font-sans font-normal text-slate-400">종</span>`;
            document.getElementById('favCountDisplay').innerHTML = `${favorites.size} <span class="text-xs font-sans font-normal text-slate-400">체</span>`;
        }

        // =========================================================================
        // 4. FILTERING, SORTING & GRID RENDERING
        // =========================================================================
        function setAttrFilter(attr) {
            currentAttrFilter = attr;
            document.querySelectorAll('.attr-btn').forEach(btn => {
                const isSelected = btn.dataset.attr === attr;
                if (isSelected) {
                    btn.className = 'attr-btn active px-2.5 py-1.5 rounded-lg text-xs font-bold bg-cyan-500 text-slate-950 shadow-neon-cyan transition-all';
                } else {
                    const colorMap = { '백신': 'text-sky-400', '데이터': 'text-emerald-400', '바이러스': 'text-rose-400', '프리': 'text-purple-400', 'ALL': 'text-slate-300' };
                    btn.className = `attr-btn px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-digi-card border border-digi-border ${colorMap[btn.dataset.attr] || 'text-slate-300'} hover:border-cyan-400 transition-all`;
                }
            });
            renderGrid();
        }

        function setStageFilter(stage) {
            currentStageFilter = stage;
            document.querySelectorAll('.stage-btn').forEach(btn => {
                const isSelected = btn.dataset.stage === stage;
                if (isSelected) {
                    btn.className = 'stage-btn active px-3 py-1 rounded-lg text-xs font-bold bg-digi-orange text-white shadow-neon-orange transition-all';
                } else {
                    btn.className = 'stage-btn px-3 py-1 rounded-lg text-xs font-medium bg-digi-bg border border-digi-border text-slate-300 hover:border-digi-orange transition-all';
                }
            });
            renderGrid();
        }

        function toggleFavoriteOnly() {
            showFavoritesOnly = !showFavoritesOnly;
            const btn = document.getElementById('favFilterBtn');
            const icon = document.getElementById('favFilterIcon');
            if (showFavoritesOnly) {
                btn.classList.add('border-amber-400', 'bg-amber-500/20', 'text-amber-300');
                icon.className = 'fa-solid fa-star text-amber-400';
            } else {
                btn.classList.remove('border-amber-400', 'bg-amber-500/20', 'text-amber-300');
                icon.className = 'fa-regular fa-star text-amber-400';
            }
            renderGrid();
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('clearSearchBtn').classList.add('hidden');
            renderGrid();
        }

        function resetAllFilters() {
            clearSearch();
            setAttrFilter('ALL');
            setStageFilter('ALL');
            if (showFavoritesOnly) toggleFavoriteOnly();
        }

        function getTotalPower(stats) {
            return stats.hp + stats.atk + stats.def + stats.spd + stats.int;
        }

        function getAttributeBadgeStyle(attr) {
            switch (attr) {
                case '백신': return 'bg-sky-500/15 text-sky-400 border-sky-500/40';
                case '데이터': return 'bg-emerald-500/15 text-emerald-400 border-emerald-500/40';
                case '바이러스': return 'bg-rose-500/15 text-rose-400 border-rose-500/40';
                case '프리': return 'bg-purple-500/15 text-purple-400 border-purple-500/40';
                default: return 'bg-slate-500/20 text-slate-300 border-slate-500/40';
            }
        }

        function renderGrid() {
            const query = document.getElementById('searchInput').value.trim().toLowerCase();
            const sortBy = document.getElementById('sortSelect').value;
            const grid = document.getElementById('digimonGrid');
            const emptyState = document.getElementById('emptyState');

            let filtered = digimonDatabase.filter(d => {
                const matchesAttr = currentAttrFilter === 'ALL' || d.attribute === currentAttrFilter;
                const matchesStage = currentStageFilter === 'ALL' || d.stage === currentStageFilter;
                const matchesFav = !showFavoritesOnly || favorites.has(d.id);
                const matchesQuery = query === '' ||
                    d.nameKo.toLowerCase().includes(query) ||
                    d.nameEn.toLowerCase().includes(query) ||
                    d.type.toLowerCase().includes(query) ||
                    d.field.toLowerCase().includes(query) ||
                    d.skills.some(s => s.name.toLowerCase().includes(query));
                return matchesAttr && matchesStage && matchesFav && matchesQuery;
            });

            // Sorting
            filtered.sort((a, b) => {
                if (sortBy === 'name') return a.nameKo.localeCompare(b.nameKo, 'ko');
                if (sortBy === 'power') return getTotalPower(b.stats) - getTotalPower(a.stats);
                return a.id - b.id;
            });

            document.getElementById('filteredCountText').textContent = filtered.length;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }
            emptyState.classList.add('hidden');

            grid.innerHTML = filtered.map(d => {
                const isFav = favorites.has(d.id);
                const totalPower = getTotalPower(d.stats);
                const attrStyle = getAttributeBadgeStyle(d.attribute);

                return `
                <article onclick="openDetailModal(${d.id})" class="digimon-card tech-corner cursor-pointer bg-digi-card/95 border border-digi-border rounded-xl p-4 flex flex-col justify-between relative group">
                    <!-- Top Header: No & Favorite -->
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-cyber text-xs font-bold text-cyan-400/90 tracking-wider">${d.no}</span>
                        <button onclick="event.stopPropagation(); toggleFavorite(${d.id})" class="w-7 h-7 rounded-lg bg-digi-bg/80 hover:bg-slate-800 border border-slate-700/80 flex items-center justify-center transition-colors" title="파트너 등록">
                            <i class="${isFav ? 'fa-solid text-amber-400' : 'fa-regular text-slate-500 hover:text-amber-400'} fa-star text-xs"></i>
                        </button>
                    </div>

                    <!-- Artwork Area -->
                    <div class="relative my-1 py-3 rounded-xl bg-digi-bg/90 border border-slate-800/90 group-hover:border-cyan-500/40 holo-scan flex items-center justify-center transition-colors">
                        <div class="w-28 h-28 transform group-hover:scale-105 transition-transform duration-300">
                            ${getDigimonSVG(d.artKey)}
                        </div>
                        <span class="absolute bottom-2 right-2.5 text-[10px] font-mono text-slate-400 bg-slate-900/90 px-1.5 py-0.5 rounded border border-slate-800">
                            PWR <strong class="text-cyan-400">${totalPower}</strong>
                        </span>
                    </div>

                    <!-- Digimon Name & Classification -->
                    <div class="mt-3">
                        <div class="flex items-center gap-1.5 mb-1">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-digi-orange/20 text-digi-orange border border-digi-orange/30">${d.stage}</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold border ${attrStyle}">${d.attribute}</span>
                        </div>
                        <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors">${d.nameKo}</h3>
                        <p class="font-cyber text-[10px] text-slate-400 tracking-wider uppercase">${d.nameEn} · <span class="font-sans text-slate-400">${d.type}</span></p>
                    </div>

                    <!-- Mini Signature Skill Footer -->
                    <div class="mt-3 pt-2.5 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
                        <span class="truncate max-w-[180px]"><i class="fa-solid fa-bolt text-digi-orange mr-1"></i>${d.skills[0].name.split('(')[0]}</span>
                        <span class="text-cyan-400 font-mono text-[10px] group-hover:translate-x-0.5 transition-transform">ANALYZE &rarr;</span>
                    </div>
                </article>`;
            }).join('');
        }

        // =========================================================================
        // 5. FAVORITES MANAGEMENT
        // =========================================================================
        function toggleFavorite(id) {
            const digimon = digimonDatabase.find(d => d.id === id);
            if (favorites.has(id)) {
                favorites.delete(id);
                showToast(`${digimon.nameKo} 파트너 등록이 해제되었습니다.`);
            } else {
                favorites.add(id);
                showToast(`${digimon.nameKo}이(가) 파트너 디지몬으로 등록되었습니다!`);
            }
            localStorage.setItem(FAV_STORAGE_KEY, JSON.stringify([...favorites]));
            updateCounters();
            renderGrid();
            if (currentModalDigimonId === id) {
                updateModalFavButton(id);
            }
        }

        function toggleModalFavorite() {
            if (currentModalDigimonId !== null) {
                toggleFavorite(currentModalDigimonId);
            }
        }

        function updateModalFavButton(id) {
            const isFav = favorites.has(id);
            const icon = document.getElementById('modalFavIcon');
            const text = document.getElementById('modalFavText');
            const btn = document.getElementById('modalFavBtn');

            if (isFav) {
                icon.className = 'fa-solid fa-star text-amber-400';
                text.textContent = '파트너 등록됨';
                btn.classList.add('border-amber-400/60', 'text-amber-300');
            } else {
                icon.className = 'fa-regular fa-star text-amber-400';
                text.textContent = '파트너 등록';
                btn.classList.remove('border-amber-400/60', 'text-amber-300');
            }
        }

        // =========================================================================
        // 6. DIGIVICE DETAIL MODAL & EVOLUTION NAVIGATION
        // =========================================================================
        function openDetailModal(id) {
            const d = digimonDatabase.find(item => item.id === id);
            if (!d) return;

            currentModalDigimonId = id;
            updateModalFavButton(id);

            document.getElementById('modalNo').textContent = d.no;
            document.getElementById('modalFieldBadge').textContent = d.field;
            document.getElementById('modalArtwork').innerHTML = getDigimonSVG(d.artKey);
            document.getElementById('modalTotalPower').textContent = getTotalPower(d.stats);

            document.getElementById('modalStageBadge').textContent = d.stage;
            const attrBadge = document.getElementById('modalAttrBadge');
            attrBadge.textContent = d.attribute;
            attrBadge.className = `px-2.5 py-0.5 rounded-md text-xs font-bold border ${getAttributeBadgeStyle(d.attribute)}`;
            document.getElementById('modalTypeBadge').textContent = d.type;

            document.getElementById('modalNameKo').textContent = d.nameKo;
            document.getElementById('modalNameEn').textContent = d.nameEn;
            document.getElementById('modalDesc').textContent = d.desc;

            // Render Stat Bars
            const statDefs = [
                { key: 'hp', label: 'HP (체력)', color: 'bg-emerald-400' },
                { key: 'atk', label: 'ATK (공격력)', color: 'bg-rose-500' },
                { key: 'def', label: 'DEF (방어력)', color: 'bg-sky-400' },
                { key: 'spd', label: 'SPD (스피드)', color: 'bg-amber-400' },
                { key: 'int', label: 'INT (지능)', color: 'bg-purple-400' }
            ];
            document.getElementById('modalStatsContainer').innerHTML = statDefs.map(s => {
                const val = d.stats[s.key];
                return `
                <div class="flex items-center gap-3 text-xs">
                    <span class="w-24 font-mono text-slate-300 shrink-0">${s.label}</span>
                    <div class="flex-1 h-2 bg-slate-800 rounded-full overflow-hidden">
                        <div class="${s.color} h-full rounded-full transition-all duration-500" style="width: ${val}%"></div>
                    </div>
                    <span class="w-8 text-right font-cyber font-bold text-white">${val}</span>
                </div>`;
            }).join('');

            // Render Special Moves
            document.getElementById('modalSkillsContainer').innerHTML = d.skills.map(skill => `
                <div class="p-3.5 rounded-xl bg-digi-bg border border-digi-border hover:border-digi-orange/50 transition-colors">
                    <div class="font-bold text-xs sm:text-sm text-digi-orange mb-1">${skill.name}</div>
                    <p class="text-xs text-slate-300 leading-relaxed">${skill.desc}</p>
                </div>
            `).join('');

            // Render Interactive Evolution Line
            renderEvolutionLine(d);

            const modal = document.getElementById('detailModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function renderEvolutionLine(currentDigimon) {
            const container = document.getElementById('modalEvoContainer');
            const prevList = currentDigimon.evoPrev.map(pid => digimonDatabase.find(x => x.id === pid)).filter(Boolean);
            const nextList = currentDigimon.evoNext.map(nid => digimonDatabase.find(x => x.id === nid)).filter(Boolean);

            const createNodeHTML = (digimon, isCurrent = false) => `
                <div onclick="${isCurrent ? '' : `openDetailModal(${digimon.id})`}" 
                     class="${isCurrent ? 'border-cyan-400 bg-cyan-950/40 shadow-neon-cyan' : 'cursor-pointer border-slate-700 bg-digi-card hover:border-cyan-400'} border rounded-xl p-2.5 flex flex-col items-center w-28 text-center transition-all">
                    <span class="text-[9px] font-mono ${isCurrent ? 'text-cyan-400 font-bold' : 'text-slate-400'}">${digimon.stage}</span>
                    <div class="w-12 h-12 my-1">${getDigimonSVG(digimon.artKey)}</div>
                    <span class="text-xs font-bold text-white truncate w-full">${digimon.nameKo}</span>
                </div>
            `;

            let html = '';

            // Previous Stage(s)
            if (prevList.length > 0) {
                html += `<div class="flex flex-wrap justify-center gap-2">${prevList.map(p => createNodeHTML(p, false)).join('')}</div>`;
                html += `<div class="text-cyan-400 font-cyber text-sm px-1"><i class="fa-solid fa-angles-right"></i></div>`;
            }

            // Current Stage
            html += createNodeHTML(currentDigimon, true);

            // Next Stage(s)
            if (nextList.length > 0) {
                html += `<div class="text-digi-orange font-cyber text-sm px-1"><i class="fa-solid fa-angles-right"></i></div>`;
                html += `<div class="flex flex-wrap justify-center gap-2">${nextList.map(n => createNodeHTML(n, false)).join('')}</div>`;
            }

            if (prevList.length === 0 && nextList.length === 0) {
                html += `<span class="text-xs text-slate-400 ml-3">단독 궁극체 / 특수 진화 개체</span>`;
            }

            container.innerHTML = html;
        }

        function closeDetailModal(e) {
            if (e.target.id === 'detailModal') {
                forceCloseDetailModal();
            }
        }

        function forceCloseDetailModal() {
            const modal = document.getElementById('detailModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            currentModalDigimonId = null;
        }

        // Type Chart Modal Controls
        function openTypeChartModal() {
            const modal = document.getElementById('typeChartModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeTypeChartModal(e) {
            if (e.target.id === 'typeChartModal') {
                const modal = document.getElementById('typeChartModal');
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        // Close modals with ESC key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                forceCloseDetailModal();
                const typeModal = document.getElementById('typeChartModal');
                typeModal.classList.add('hidden');
                typeModal.classList.remove('flex');
            }
        });
    </script>
</body>
</html>
